    <bpmn:dataObjectReference id="DOR_AcordosSquad" name="Acordos das squads" dataObjectRef="DO_AcordosSquad" />
    <bpmn:association id="Assoc_AcordosSquad" sourceRef="A_GerirSquads" targetRef="DOR_AcordosSquad" associationDirection="One" />
    <bpmn:dataObject id="DO_BacklogAtualizado" name="Backlog atualizado" />
    <bpmn:dataObjectReference id="DOR_BacklogAtualizado" name="Backlog atualizado" dataObjectRef="DO_BacklogAtualizado" />
    <bpmn:association id="Assoc_BacklogAtualizado" sourceRef="A_AjustarPoC" targetRef="DOR_BacklogAtualizado" associationDirection="One" />
    <bpmn:sequenceFlow id="F44" sourceRef="A_GerirSquads" targetRef="A_DecomporTasks" />
  </bpmn:process>
  <bpmn:process id="Process_Sprint_Proposto" name="Sprint regular de duas semanas" isExecutable="false">
    <bpmn:startEvent id="Sprint_Start" name="Início" />
    <bpmn:task id="Sprint_Planning" name="Planejar blocos curtos" />
    <bpmn:task id="Sprint_Work" name="Executar tasks em pares" />
    <bpmn:task id="Sprint_BlockFeedback" name="Revisar bloco e obter feedback" />
    <bpmn:exclusiveGateway id="Sprint_Continue" name="Continuar ou ajustar no tempo restante?" />
    <bpmn:task id="Sprint_Meeting" name="Aula Meeting" />
    <bpmn:parallelGateway id="Sprint_Split" />
    <bpmn:parallelGateway id="Sprint_Join" />
    <bpmn:endEvent id="Sprint_End" name="Fim" />
    <bpmn:sequenceFlow id="SF1" sourceRef="Sprint_Start" targetRef="Sprint_Planning" />
    <bpmn:sequenceFlow id="SF2" sourceRef="Sprint_Planning" targetRef="Sprint_Split" />
    <bpmn:sequenceFlow id="SF3" sourceRef="Sprint_Split" targetRef="Sprint_Work" />
    <bpmn:sequenceFlow id="SF4" sourceRef="Sprint_Split" targetRef="Sprint_Meeting" />
    <bpmn:sequenceFlow id="SF5" sourceRef="Sprint_Work" targetRef="Sprint_BlockFeedback" />
    <bpmn:sequenceFlow id="SF6" sourceRef="Sprint_Meeting" targetRef="Sprint_Join" />
    <bpmn:sequenceFlow id="SF7" sourceRef="Sprint_BlockFeedback" targetRef="Sprint_Continue" />
    <bpmn:sequenceFlow id="SF8" name="Sim: próximo bloco/ajuste" sourceRef="Sprint_Continue" targetRef="Sprint_Work" />
    <bpmn:sequenceFlow id="SF9" name="Não: blocos concluídos" sourceRef="Sprint_Continue" targetRef="Sprint_Join" />
    <bpmn:sequenceFlow id="SF10" sourceRef="Sprint_Join" targetRef="Sprint_End" />
  </bpmn:process>
