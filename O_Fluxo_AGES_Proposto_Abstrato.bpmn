      <bpmndi:BPMNEdge id="DI_F13" bpmnElement="F13"><di:waypoint x="2925" y="155"/><di:waypoint x="2925" y="120"/><di:waypoint x="955" y="120"/><di:waypoint x="955" y="155"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F14" bpmnElement="F14"><di:waypoint x="2754" y="195"/><di:waypoint x="3100" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F15" bpmnElement="F15"><di:waypoint x="3127" y="222"/><di:waypoint x="3127" y="640"/><di:waypoint x="2240" y="640"/><di:waypoint x="2240" y="605"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F16" bpmnElement="F16"><di:waypoint x="3154" y="195"/><di:waypoint x="3280" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_MF_Contexto" bpmnElement="MF_Contexto"><di:waypoint x="120" y="765"/><di:waypoint x="380" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_MF_Feedback" bpmnElement="MF_Feedback"><di:waypoint x="2530" y="155"/><di:waypoint x="120" y="765"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
