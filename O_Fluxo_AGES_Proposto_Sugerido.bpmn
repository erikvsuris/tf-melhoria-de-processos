      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Epicos">
        <bpmn:targetRef>DOR_Epicos</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_DefinirHistorias" name="Especificar histórias">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Historias">
        <bpmn:targetRef>DOR_Historias</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_FormarSquads" name="Formar squads">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Squads">
        <bpmn:targetRef>DOR_Squads</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_GerirSquads" name="Gerenciar squads">
