    <bpmn:textAnnotation id="Note_Pairing">
      <bpmn:text>AGES I e II desenvolvem em pares inter-níveis, com apoio técnico de AGES III e IA conforme guardrails de AGES IV. WIP 0,5 por integrante.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Pairing" sourceRef="A_ConstruirPoC" targetRef="Note_Pairing" associationDirection="None" />
