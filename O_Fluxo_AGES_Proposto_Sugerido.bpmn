      <bpmn:outgoing>F44</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_AcordosSquad">
        <bpmn:targetRef>DOR_AcordosSquad</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_DecomporTasks" name="Decompor histórias em tasks">
      <bpmn:incoming>F44</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_TaskBacklog">
        <bpmn:targetRef>DOR_TaskBacklog</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_DefinirGuardrails" name="Definir políticas, processos e guardrails de IA">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Guardrails">
        <bpmn:targetRef>DOR_Guardrails</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_CoordPoC" name="Coordenar PoC transversalmente">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_AgendaPoC">
        <bpmn:targetRef>DOR_AgendaPoC</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_DesignSystem" name="Preparar design system">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_DesignSystem">
        <bpmn:targetRef>DOR_DesignSystem</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_ConfigIA" name="Habilitar ferramental, ambiente e agente de IA">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_AgenteIA">
        <bpmn:targetRef>DOR_AgenteIA</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_Wireframes" name="Criar wireframes">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Wireframes">
        <bpmn:targetRef>DOR_Wireframes</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_Wireflows" name="Desenhar wireflows">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Wireflows">
        <bpmn:targetRef>DOR_Wireflows</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_MergePoC" gatewayDirection="Converging">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:incoming>F40_Back</bpmn:incoming>
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:outgoing>F22b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_ConstruirPoC" name="Construir PoC em pares com apoio de IA">
      <bpmn:incoming>F22b</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_PoC">
        <bpmn:targetRef>DOR_PoC</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_DemoCodeReview" name="Demonstrar implementação no code review">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F23b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_CodeReviewIII" name="Revisar código e dar feedback técnico">
      <bpmn:incoming>F23b</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_PoCRevIII" name="Aprovado tecnicamente?" gatewayDirection="Diverging">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F24_No</bpmn:outgoing>
      <bpmn:outgoing>F24_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_AprovarTaskIV" name="Validar DoD e aprovar entrega">
      <bpmn:incoming>F24_Yes</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_ReviewTasks">
        <bpmn:targetRef>DOR_ReviewTasks</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_PoCRevIV" name="Atende à DoD?" gatewayDirection="Diverging">
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:outgoing>F40_No</bpmn:outgoing>
      <bpmn:outgoing>F41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_DemoPoC" name="Demonstrar PoCs">
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Critique">
        <bpmn:targetRef>DOR_Critique</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_ValidarUsuarios" name="Validar PoC com usuários">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Validacao">
        <bpmn:targetRef>DOR_Validacao</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_PoCValidada" name="PoC atende aos critérios?" gatewayDirection="Diverging">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_MergePlanning" gatewayDirection="Converging">
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:incoming>F43</bpmn:incoming>
      <bpmn:outgoing>F38b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_Planning" name="Sprint Planning">
      <bpmn:incoming>F38b</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_SprintBacklog">
        <bpmn:targetRef>DOR_SprintBacklog</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:parallelGateway id="G_SprintSplit" gatewayDirection="Diverging">
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>FS_MeetIn</bpmn:outgoing>
      <bpmn:outgoing>FS_WorkIn</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="G_MergeBlock" gatewayDirection="Converging">
      <bpmn:incoming>FS_WorkIn</bpmn:incoming>
      <bpmn:incoming>FS_Back</bpmn:incoming>
      <bpmn:incoming>FS_Next_Yes</bpmn:incoming>
      <bpmn:outgoing>FS_Dev</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_DevSprint" name="Desenvolver tasks em pares com apoio de IA">
      <bpmn:incoming>FS_Dev</bpmn:incoming>
      <bpmn:outgoing>FS_DemoCR</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_DemoCodeReviewSprint" name="Demonstrar implementação no code review">
      <bpmn:incoming>FS_DemoCR</bpmn:incoming>
      <bpmn:outgoing>FS_CRIII</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_CodeReviewSprintIII" name="Revisar código e dar feedback técnico">
      <bpmn:incoming>FS_CRIII</bpmn:incoming>
      <bpmn:outgoing>FS_GWIII</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_SprintRevIII" name="Aprovado tecnicamente?" gatewayDirection="Diverging">
      <bpmn:incoming>FS_GWIII</bpmn:incoming>
      <bpmn:outgoing>FS_III_No</bpmn:outgoing>
      <bpmn:outgoing>FS_III_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_AprovarSprintIV" name="Validar DoD e aprovar entrega">
      <bpmn:incoming>FS_III_Yes</bpmn:incoming>
      <bpmn:outgoing>FS_GWIV</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_SprintRevIV" name="Atende à DoD?" gatewayDirection="Diverging">
      <bpmn:incoming>FS_GWIV</bpmn:incoming>
      <bpmn:outgoing>FS_IV_No</bpmn:outgoing>
