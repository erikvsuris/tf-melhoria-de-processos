<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_O_Fluxo_AGES" name="O Fluxo AGES" targetNamespace="https://ages.pucrs.br/bpmn/o-fluxo-ages" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.0">
  <bpmn:documentation>Modelo atual reconstruído a partir de ProcessosAGES-ProcessoAGES-v6.png, Papeis_Responsabilidades_v4.pdf e do enunciado MPS2026_2_TF_Enunciado.pdf. Os rótulos das etapas e atividades seguem os materiais anexos; as propostas de melhoria do README não estão incorporadas.</bpmn:documentation>
  <bpmn:collaboration id="Collaboration_AGES">
    <bpmn:participant id="Participant_AGES" name="O FLUXO AGES (ATUAL)" processRef="Process_AGES" />
    <bpmn:participant id="Participant_Stakeholders" name="Stakeholders" />
    <bpmn:messageFlow id="MF_Idea" sourceRef="Participant_Stakeholders" targetRef="S1_IdeaPresentation" />
    <bpmn:messageFlow id="MF_ProjectIntro" name="Apresentação dos projetos" sourceRef="Participant_Stakeholders" targetRef="S2_ProjectIntro" />
    <bpmn:messageFlow id="MF_S0Presentation" sourceRef="S2_Presentation" targetRef="Participant_Stakeholders" />
    <bpmn:messageFlow id="MF_FinalPresentation" sourceRef="S4_FinalPresentation" targetRef="Participant_Stakeholders" />
    <bpmn:textAnnotation id="Etapa_1">
      <bpmn:text>Etapa 1: Semestre que antecede a execução do projeto na AGES</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Etapa_2">
      <bpmn:text>Etapa 2: Organização e kick-off do projeto</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Etapa_3">
      <bpmn:text>Etapa 3: Sprints iniciais e Revisão intermediária</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Sprints_1_2">
      <bpmn:text>Sprints 1 e 2</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Apos_Sprint_1">
      <bpmn:text>Após a sprint 1</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Sprints_3_4">
      <bpmn:text>Sprints 3 e 4</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Etapa_4">
      <bpmn:text>Etapa 4: Encerramento</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Semana_Final">
      <bpmn:text>Semana Final</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:message id="Message_Idea" name="Apresentação da Ideia pelos stakeholder" />
  <bpmn:process id="Process_AGES" name="O Fluxo AGES" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AGES">
      <bpmn:lane id="Lane_1" name="Coordenação">
        <bpmn:flowNodeRef>Start_Idea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_IdeaPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_ValidateIdea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_Semester</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_Meetings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_Requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_Charter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_Gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_Intro</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Professor Orientador">
        <bpmn:flowNodeRef>End_AGES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_OneOnOne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_OneOnOne</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_Progress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_Process</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Aluno">
        <bpmn:flowNodeRef>S3_Sprint2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_Sprint3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_Sprint4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_Retro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_FinalReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_FinalPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_Sprint1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_Presentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_WorkJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_Studies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_PlanningDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_Architecture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_ReqMockups</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_WorkSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_ProjectIntro</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="AGES IV">
        <bpmn:flowNodeRef>S4_Bancas</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="F22" sourceRef="S2_Studies" targetRef="S2_Join" />
    <bpmn:sequenceFlow id="F20" sourceRef="S2_WorkJoin" targetRef="S2_Presentation" />
    <bpmn:sequenceFlow id="F19" sourceRef="S2_PlanningDocs" targetRef="S2_WorkJoin" />
    <bpmn:sequenceFlow id="F18" sourceRef="S2_Architecture" targetRef="S2_WorkJoin" />
    <bpmn:sequenceFlow id="F17" sourceRef="S2_ReqMockups" targetRef="S2_WorkJoin" />
    <bpmn:sequenceFlow id="F16" sourceRef="S2_WorkSplit" targetRef="S2_PlanningDocs" />
    <bpmn:sequenceFlow id="F15" sourceRef="S2_WorkSplit" targetRef="S2_Architecture" />
    <bpmn:sequenceFlow id="F14" sourceRef="S2_WorkSplit" targetRef="S2_ReqMockups" />
    <bpmn:sequenceFlow id="F13" sourceRef="S2_Split" targetRef="S2_WorkSplit" />
    <bpmn:sequenceFlow id="F12" sourceRef="S2_Split" targetRef="S2_Studies" />
    <bpmn:sequenceFlow id="F11" sourceRef="S2_ProjectIntro" targetRef="S2_Split" />
    <bpmn:sequenceFlow id="F10" sourceRef="S2_Process" targetRef="S2_ProjectIntro" />
    <bpmn:sequenceFlow id="F9" sourceRef="S2_Intro" targetRef="S2_Process" />
    <bpmn:sequenceFlow id="F21" sourceRef="S2_Presentation" targetRef="S2_Join" />
    <bpmn:sequenceFlow id="F23" sourceRef="S2_Join" targetRef="S3_Sprint1" />
    <bpmn:sequenceFlow id="F24" sourceRef="S3_Sprint1" targetRef="S3_Progress" />
    <bpmn:sequenceFlow id="F25" sourceRef="S3_Progress" targetRef="S3_OneOnOne" />
    <bpmn:sequenceFlow id="F26" sourceRef="S3_OneOnOne" targetRef="S3_Sprint2" />
    <bpmn:sequenceFlow id="F29" sourceRef="S3_Sprint4" targetRef="S4_Bancas" />
    <bpmn:sequenceFlow id="F30" sourceRef="S4_Bancas" targetRef="S4_Retro" />
    <bpmn:sequenceFlow id="F33" sourceRef="S4_FinalPresentation" targetRef="S4_OneOnOne" />
    <bpmn:sequenceFlow id="F34" sourceRef="S4_OneOnOne" targetRef="End_AGES" />
    <bpmn:endEvent id="End_AGES" name="Fim" />
    <bpmn:task id="S4_OneOnOne" name="ONE on ONE (com os alunos)" />
    <bpmn:task id="S4_Bancas" name="Apresentação das BANCAS" />
    <bpmn:task id="S3_OneOnOne" name="ONE on ONE (com os alunos)" />
    <bpmn:callActivity id="S3_Sprint2" name="Sprint Duas Semanas" calledElement="Process_Sprint">
      <bpmn:documentation>Representa a Sprint 2 no agrupamento “Sprints 1 e 2”.</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:callActivity id="S3_Sprint3" name="Sprint Duas Semanas" calledElement="Process_Sprint">
      <bpmn:documentation>Representa a Sprint 3 no agrupamento “Sprints 3 e 4”.</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:callActivity id="S3_Sprint4" name="Sprint Duas Semanas" calledElement="Process_Sprint">
      <bpmn:documentation>Representa a Sprint 4 no agrupamento “Sprints 3 e 4”.</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:task id="S4_Retro" name="Retrospectiva geral da AGES + Confraternização" />
    <bpmn:task id="S4_FinalReport" name="Entrega Relatório Final" />
    <bpmn:task id="S4_FinalPresentation" name="Apresentação dos projetos da AGES (estudantes + stakeholders + professores)" />
    <bpmn:sequenceFlow id="F27" sourceRef="S3_Sprint2" targetRef="S3_Sprint3" />
    <bpmn:sequenceFlow id="F28" sourceRef="S3_Sprint3" targetRef="S3_Sprint4" />
    <bpmn:sequenceFlow id="F31" sourceRef="S4_Retro" targetRef="S4_FinalReport" />
    <bpmn:sequenceFlow id="F32" sourceRef="S4_FinalReport" targetRef="S4_FinalPresentation" />
    <bpmn:task id="S3_Progress" name="Entrega Relatório de Andamento" />
    <bpmn:callActivity id="S3_Sprint1" name="Sprint Duas Semanas" calledElement="Process_Sprint">
      <bpmn:documentation>Representa a Sprint 1 no agrupamento “Sprints 1 e 2”.</bpmn:documentation>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="S2_Join" name="" />
    <bpmn:task id="S2_Presentation" name="Apresentação para stakeholders" />
    <bpmn:parallelGateway id="S2_WorkJoin" name="" />
    <bpmn:task id="S2_Studies" name="Estudos das tecnologias utilizadas nos projetos (linguagens e metodologias TDD, BDD, Code review, pair programming, etc..)" />
    <bpmn:task id="S2_PlanningDocs" name="EAP / Cronograma / Plano de Comunicação / U.S. (AGES IV)" />
    <bpmn:task id="S2_Architecture" name="Definição Arquitetura ou revisão (AGES III)" />
    <bpmn:task id="S2_ReqMockups" name="Documentação dos Requisitos e Mockups (Time)" />
    <bpmn:parallelGateway id="S2_WorkSplit" name="" />
    <bpmn:parallelGateway id="S2_Split" name="" />
    <bpmn:task id="S2_ProjectIntro" name="Apresentação dos projetos pelos stakeholders" />
    <bpmn:task id="S2_Process" name="Apresentação do Processo da AGES, responsabilidades e artefatos, apresentação dos relatórios (sprint, andamento e final)" />
    <bpmn:startEvent id="Start_Idea" name="Início" />
    <bpmn:receiveTask id="S1_IdeaPresentation" name="Apresentação da Ideia pelos stakeholder" messageRef="Message_Idea" />
    <bpmn:task id="S1_ValidateIdea" name="Validação da Ideia" />
    <bpmn:task id="S1_Semester" name="Definição do semestre que o projeto irá ser executado">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>Flow_1uqpujp</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S1_Meetings" name="Reuniões mensais com os Stakeholders">
      <bpmn:incoming>Flow_1uqpujp</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="S1_Requirements" name="Validação dos Requisitos" />
    <bpmn:task id="S1_Charter" name="Elaboração do Termo de Abertura de Projetos" />
    <bpmn:exclusiveGateway id="S1_Gateway" name="">
      <bpmn:documentation>A fonte mostra o ciclo entre reuniões mensais, validação dos requisitos e elaboração do termo, mas não explicita a condição para iniciar a execução. O gateway com saídas Sim/Não é uma interpretação para representar a transição entre Etapa 1 e Etapa 2.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S2_Intro" name="Apresentação Inicial AGES e do Fluxo AGES." />
    <bpmn:sequenceFlow id="F0" sourceRef="Start_Idea" targetRef="S1_IdeaPresentation" />
    <bpmn:sequenceFlow id="F1" sourceRef="S1_IdeaPresentation" targetRef="S1_ValidateIdea" />
    <bpmn:sequenceFlow id="F2" sourceRef="S1_ValidateIdea" targetRef="S1_Semester" />
    <bpmn:sequenceFlow id="F8" name="Não" sourceRef="S1_Gateway" targetRef="S1_Semester" />
    <bpmn:sequenceFlow id="Flow_1uqpujp" sourceRef="S1_Semester" targetRef="S1_Meetings" />
    <bpmn:sequenceFlow id="F4" sourceRef="S1_Meetings" targetRef="S1_Requirements" />
    <bpmn:sequenceFlow id="F5" sourceRef="S1_Requirements" targetRef="S1_Charter" />
    <bpmn:sequenceFlow id="F6" sourceRef="S1_Charter" targetRef="S1_Gateway" />
    <bpmn:sequenceFlow id="F7" name="Sim" sourceRef="S1_Gateway" targetRef="S2_Intro" />
  </bpmn:process>
  <bpmn:process id="Process_Sprint" name="Sprint Duas Semanas" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Sprint">
      <bpmn:lane id="Sprint_Lane_1" name="Professor Orientador">
        <bpmn:flowNodeRef>Sprint_Meeting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Sprint_Lane_2" name="Aluno">
        <bpmn:flowNodeRef>Sprint_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_Planning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_Development</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_Delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_Retro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Sprint_Start" name="Início" />
    <bpmn:task id="Sprint_Planning" name="Planning" />
    <bpmn:parallelGateway id="Sprint_Split" name="" />
    <bpmn:task id="Sprint_Meeting" name="Aula Meeting" />
    <bpmn:task id="Sprint_Development" name="Desenvolvimento Documentação" />
    <bpmn:parallelGateway id="Sprint_Join" name="" />
    <bpmn:task id="Sprint_Delivery" name="Entrega para os Stakeholders" />
    <bpmn:task id="Sprint_Retro" name="Retrospectiva" />
    <bpmn:task id="Sprint_Report" name="Entrega do relatório da Sprint" />
    <bpmn:endEvent id="Sprint_End" name="Fim" />
    <bpmn:sequenceFlow id="Sprint_F1" sourceRef="Sprint_Start" targetRef="Sprint_Planning" />
    <bpmn:sequenceFlow id="Sprint_F2" sourceRef="Sprint_Planning" targetRef="Sprint_Split" />
    <bpmn:sequenceFlow id="Sprint_F3" sourceRef="Sprint_Split" targetRef="Sprint_Meeting" />
    <bpmn:sequenceFlow id="Sprint_F4" sourceRef="Sprint_Split" targetRef="Sprint_Development" />
    <bpmn:sequenceFlow id="Sprint_F5" sourceRef="Sprint_Meeting" targetRef="Sprint_Join" />
    <bpmn:sequenceFlow id="Sprint_F6" sourceRef="Sprint_Development" targetRef="Sprint_Join" />
    <bpmn:sequenceFlow id="Sprint_F7" sourceRef="Sprint_Join" targetRef="Sprint_Delivery" />
    <bpmn:sequenceFlow id="Sprint_F8" sourceRef="Sprint_Delivery" targetRef="Sprint_Retro" />
    <bpmn:sequenceFlow id="Sprint_F9" sourceRef="Sprint_Retro" targetRef="Sprint_Report" />
    <bpmn:sequenceFlow id="Sprint_F10" sourceRef="Sprint_Report" targetRef="Sprint_End" />
  </bpmn:process>
