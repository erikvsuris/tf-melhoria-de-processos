<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AGES_Abstrato" name="Fluxo AGES" targetNamespace="https://ages.pucrs.br/bpmn/o-fluxo-ages-proposto-abstrato" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.1">
  <bpmn:documentation>Processo geral abstrato proposto para a equipe AGES. O diagrama não impõe metodologia, Sprint 0, cerimônias ou cadência específicas. AGES IV define e adapta o processo próprio da equipe; AGES III oferece liderança técnica e habilitação como Enabling Team; a equipe executa conforme os acordos. O processo escolhido e seus resultados são avaliáveis na banca. Este BPMN é distinto da instância concreta descrita em O_Fluxo_AGES_Proposto_Sugerido.bpmn.</bpmn:documentation>
  <bpmn:collaboration id="Collaboration_AGES_Abstrato">
    <bpmn:participant id="Participant_Processo" name="Fluxo AGES" processRef="Processo_Abstrato"/>
    <bpmn:participant id="Participant_Stakeholders" name="Coordenação e Stakeholders"/>
    <bpmn:messageFlow id="MF_Contexto" name="Objetivos, contexto e restrições" sourceRef="Participant_Stakeholders" targetRef="A_Contexto"/>
    <bpmn:messageFlow id="MF_Entregas" name="Entregas e resultados" sourceRef="A_Avaliar" targetRef="Participant_Stakeholders"/>
    <bpmn:messageFlow id="MF_Feedback" name="Feedback sobre resultados e adequação do processo" sourceRef="Participant_Stakeholders" targetRef="A_Avaliar"/>
  </bpmn:collaboration>
  <bpmn:process id="Processo_Abstrato" name="Fluxo AGES" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Abstrato">
      <bpmn:lane id="Lane_AGESIV" name="AGES IV">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Contexto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_MergeDefinir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DefinirMetodo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DefinirPoliticasIA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ClarezaViabilidade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Comunicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Avaliar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Ajustar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_AjustarProcesso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Concluido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AGESIII" name="AGES III">
        <bpmn:flowNodeRef>A_AnalisarTecnico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_HabilitarTecnico</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Equipe" name="Equipe AGES">
        <bpmn:flowNodeRef>G_MergeExecutar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Executar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Projeto/equipe designados">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="A_Contexto" name="Alinhar objetivos e restrições">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_AnalisarTecnico" name="Analisar viabilidade técnica e plataforma">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_MergeDefinir" gatewayDirection="Converging">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F03b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_DefinirMetodo" name="Definir processo da equipe">
      <bpmn:incoming>F03b</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_DefinirPoliticasIA" name="Definir políticas de IA">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_ClarezaViabilidade" name="Processo viável?" gatewayDirection="Diverging">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_HabilitarTecnico" name="Habilitar recursos técnicos e de IA">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_Comunicar" name="Comunicar acordos à equipe">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_MergeExecutar" gatewayDirection="Converging">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F09b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_Executar" name="Executar processo acordado">
      <bpmn:incoming>F09b</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_Avaliar" name="Avaliar entregas e processo">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Ajustar" name="Ajustar processo?" gatewayDirection="Diverging">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_AjustarProcesso" name="Ajustar processo">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Concluido" name="Projeto concluído?" gatewayDirection="Diverging">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="Fim">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="A_Contexto"/>
    <bpmn:sequenceFlow id="F02" sourceRef="A_Contexto" targetRef="A_AnalisarTecnico"/>
    <bpmn:sequenceFlow id="F03" sourceRef="A_AnalisarTecnico" targetRef="G_MergeDefinir"/>
    <bpmn:sequenceFlow id="F03b" sourceRef="G_MergeDefinir" targetRef="A_DefinirMetodo"/>
    <bpmn:sequenceFlow id="F04" sourceRef="A_DefinirMetodo" targetRef="A_DefinirPoliticasIA"/>
    <bpmn:sequenceFlow id="F05" sourceRef="A_DefinirPoliticasIA" targetRef="G_ClarezaViabilidade"/>
    <bpmn:sequenceFlow id="F06" sourceRef="G_ClarezaViabilidade" targetRef="G_MergeDefinir" name="Não"/>
    <bpmn:sequenceFlow id="F07" sourceRef="G_ClarezaViabilidade" targetRef="A_HabilitarTecnico" name="Sim"/>
    <bpmn:sequenceFlow id="F08" sourceRef="A_HabilitarTecnico" targetRef="A_Comunicar"/>
    <bpmn:sequenceFlow id="F09" sourceRef="A_Comunicar" targetRef="G_MergeExecutar"/>
    <bpmn:sequenceFlow id="F09b" sourceRef="G_MergeExecutar" targetRef="A_Executar"/>
    <bpmn:sequenceFlow id="F10" sourceRef="A_Executar" targetRef="A_Avaliar"/>
    <bpmn:sequenceFlow id="F11" sourceRef="A_Avaliar" targetRef="G_Ajustar"/>
    <bpmn:sequenceFlow id="F12" sourceRef="G_Ajustar" targetRef="A_AjustarProcesso" name="Sim"/>
    <bpmn:sequenceFlow id="F13" sourceRef="A_AjustarProcesso" targetRef="G_MergeDefinir"/>
    <bpmn:sequenceFlow id="F14" sourceRef="G_Ajustar" targetRef="G_Concluido" name="Não"/>
    <bpmn:sequenceFlow id="F15" sourceRef="G_Concluido" targetRef="G_MergeExecutar" name="Não"/>
    <bpmn:sequenceFlow id="F16" sourceRef="G_Concluido" targetRef="End" name="Sim"/>
  </bpmn:process>
