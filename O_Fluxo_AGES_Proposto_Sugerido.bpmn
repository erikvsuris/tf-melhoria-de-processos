  <bpmn:process id="Process_Sprint_Proposto" name="Execução da sprint (blocos curtos)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Sprint_Proposto">
      <bpmn:lane id="Sprint_Lane_Professor" name="Professor Orientador">
        <bpmn:flowNodeRef>Sprint_Meeting</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Sprint_Lane_Equipe" name="Equipe AGES">
        <bpmn:flowNodeRef>Sprint_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_Planning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_MergeWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_Work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_BlockFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_Continue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sprint_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Sprint_Start" name="Início">
      <bpmn:outgoing>SF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Sprint_Planning" name="Planejar blocos curtos da sprint">
      <bpmn:incoming>SF1</bpmn:incoming>
      <bpmn:outgoing>SF2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Sprint_Split" gatewayDirection="Diverging">
      <bpmn:incoming>SF2</bpmn:incoming>
      <bpmn:outgoing>SF3</bpmn:outgoing>
      <bpmn:outgoing>SF4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Sprint_Meeting" name="Aula Meeting">
      <bpmn:incoming>SF4</bpmn:incoming>
      <bpmn:outgoing>SF6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Sprint_MergeWork" gatewayDirection="Converging">
      <bpmn:incoming>SF3</bpmn:incoming>
      <bpmn:incoming>SF8</bpmn:incoming>
      <bpmn:outgoing>SF3b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Sprint_Work" name="Executar tasks em pares">
      <bpmn:incoming>SF3b</bpmn:incoming>
      <bpmn:outgoing>SF5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Sprint_BlockFeedback" name="Revisar bloco e obter feedback">
      <bpmn:incoming>SF5</bpmn:incoming>
      <bpmn:outgoing>SF7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Sprint_Continue" name="Continuar ou ajustar no tempo restante?" gatewayDirection="Diverging">
      <bpmn:incoming>SF7</bpmn:incoming>
      <bpmn:outgoing>SF8</bpmn:outgoing>
      <bpmn:outgoing>SF9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Sprint_Join" gatewayDirection="Converging">
      <bpmn:incoming>SF6</bpmn:incoming>
      <bpmn:incoming>SF9</bpmn:incoming>
      <bpmn:outgoing>SF10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="Sprint_End" name="Fim">
      <bpmn:incoming>SF10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF1" sourceRef="Sprint_Start" targetRef="Sprint_Planning" />
    <bpmn:sequenceFlow id="SF2" sourceRef="Sprint_Planning" targetRef="Sprint_Split" />
    <bpmn:sequenceFlow id="SF3" sourceRef="Sprint_Split" targetRef="Sprint_MergeWork" />
    <bpmn:sequenceFlow id="SF3b" sourceRef="Sprint_MergeWork" targetRef="Sprint_Work" />
    <bpmn:sequenceFlow id="SF4" sourceRef="Sprint_Split" targetRef="Sprint_Meeting" />
    <bpmn:sequenceFlow id="SF5" sourceRef="Sprint_Work" targetRef="Sprint_BlockFeedback" />
    <bpmn:sequenceFlow id="SF6" sourceRef="Sprint_Meeting" targetRef="Sprint_Join" />
    <bpmn:sequenceFlow id="SF7" sourceRef="Sprint_BlockFeedback" targetRef="Sprint_Continue" />
    <bpmn:sequenceFlow id="SF8" name="Sim: próximo bloco/ajuste" sourceRef="Sprint_Continue" targetRef="Sprint_MergeWork" />
    <bpmn:sequenceFlow id="SF9" name="Não: blocos concluídos" sourceRef="Sprint_Continue" targetRef="Sprint_Join" />
    <bpmn:sequenceFlow id="SF10" sourceRef="Sprint_Join" targetRef="Sprint_End" />
  </bpmn:process>
