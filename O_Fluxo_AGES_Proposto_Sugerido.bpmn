<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AGES_Proposto" name="O Fluxo AGES Proposto Sugerido" targetNamespace="https://ages.pucrs.br/bpmn/o-fluxo-ages-proposto-sugerido" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.1">
  <bpmn:documentation>Rascunho de alto nível para o Resultado 1 do TF de Melhoria de Processos. O Double Diamond é uma adaptação proposta pelo grupo: Coordenação e Stakeholders conduzem descoberta e definição, enquanto a equipe AGES atua no desenvolvimento e na entrega. A Sprint 0 inclui a construção iterativa de PoCs, com apoio de IA, revisão humana e validação com usuários.</bpmn:documentation>
  <bpmn:collaboration id="Collaboration_Proposto">
    <bpmn:participant id="Participant_Proposto" name="O FLUXO AGES PROPOSTO SUGERIDO" processRef="Process_Proposto"/>
    <bpmn:participant id="Participant_Stakeholders" name="Stakeholders"/>
    <bpmn:participant id="Participant_Usuarios" name="Usuários"/>
    <bpmn:messageFlow id="MF_Ideia" name="Ideia" sourceRef="Participant_Stakeholders" targetRef="A_Ideia"/>
    <bpmn:messageFlow id="MF_Requisitos" name="Requisitos para validação" sourceRef="A_ReqStakeholders" targetRef="Participant_Stakeholders"/>
    <bpmn:messageFlow id="MF_PoC" name="Demonstração da PoC" sourceRef="A_DemoPoC" targetRef="Participant_Stakeholders"/>
    <bpmn:messageFlow id="MF_Usuario" name="Feedback dos usuários" sourceRef="Participant_Usuarios" targetRef="A_ValidarUsuarios"/>
    <bpmn:messageFlow id="MF_Entrega" name="Incremento para Stakeholders" sourceRef="A_EntregaSprint" targetRef="Participant_Stakeholders"/>
    <bpmn:textAnnotation id="Note_Etapa1">
      <bpmn:text>Etapa 1: Semestre que antecede a execução do projeto na AGES</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Etapa2">
      <bpmn:text>Etapa 2: Organização e kick-off do projeto</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Sprint0">
      <bpmn:text>Sprint 0 — PoC</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Diamond1">
      <bpmn:text>Double Diamond — Descobrir/Definir: Coordenação e Stakeholders</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Diamond2">
      <bpmn:text>Double Diamond — Desenvolver/Entregar: equipe AGES I–IV</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Etapa3">
      <bpmn:text>Etapa 3: Sprints iniciais e Revisão intermediária</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Etapa4">
      <bpmn:text>Etapa 4: Encerramento</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_MiniSprints">
      <bpmn:text>Na planning, acordar colaborativamente duração, objetivo e entregável de cada bloco curto. Ao fim do bloco, revisar/demonstrar o incremento, colher feedback e decidir: ajustar ou iniciar outro bloco ainda no tempo restante da sprint.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_MiniSprints" associationDirection="None" sourceRef="A_Sprints" targetRef="Note_MiniSprints"/>
    <bpmn:messageFlow id="MF_NPS" name="Formulário NPS" sourceRef="A_EnviarNPS" targetRef="Participant_Stakeholders"/>
  </bpmn:collaboration>
  <bpmn:message id="Message_Ideia" name="Apresentação da Ideia pelos stakeholder"/>
  <bpmn:process id="Process_Proposto" name="O Fluxo AGES Proposto Sugerido" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proposto">
      <bpmn:lane id="Lane_AGESI_II" name="Equipe AGES">
        <bpmn:flowNodeRef>A_MapearJornada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DefinirMVP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DecomporTasks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Wireframes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Wireflows</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ConstruirPoC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DemoPoC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ValidarUsuarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PoCValidada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_AjustarPoC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Planning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RetroSprint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Sprints</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SprintsConcluidas</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AGESIII" name="AGES III">
        <bpmn:flowNodeRef>A_DesignSystem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ConfigIA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_CodeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_AprovarTaskIII</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AGESIV" name="AGES IV">
        <bpmn:flowNodeRef>A_DefinirEpicos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DefinirHistorias</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_FormarSquads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DefinirGuardrails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_CoordPoC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_AprovarTaskIV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_GerirSquads</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Professor" name="Professor Orientador">
        <bpmn:flowNodeRef>A_OneOnOne</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordenacao" name="Coordenação">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Ideia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ValidarIdeia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Semestre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ReqStakeholders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ValidarReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Termo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Aprovado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Intro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EntregaSprint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Andamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Bancas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RetroGeral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RelatorioFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ApresentacaoFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EnviarNPS</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Início"/>
    <bpmn:receiveTask id="A_Ideia" name="Apresentação da Ideia pelos stakeholder" messageRef="Message_Ideia"/>
    <bpmn:task id="A_Semestre" name="Definir semestre de execução"/>
    <bpmn:task id="A_ReqStakeholders" name="Elicitar requisitos com Stakeholders"/>
    <bpmn:task id="A_ValidarReq" name="Validar requisitos"/>
    <bpmn:task id="A_Termo" name="Elaborar termo de abertura"/>
    <bpmn:exclusiveGateway id="G_Aprovado" name="Projeto aprovado e pronto para execução?"/>
    <bpmn:task id="A_Intro" name="Apresentar AGES e fluxo"/>
    <bpmn:callActivity id="A_Sprints" name="Executar sprints regulares" calledElement="Process_Sprint_Proposto"/>
    <bpmn:task id="A_EntregaSprint" name="Sprint Review"/>
    <bpmn:task id="A_RetroSprint" name="Retrospectiva da sprint"/>
    <bpmn:task id="A_Andamento" name="Entregar relatório de andamento"/>
    <bpmn:task id="A_OneOnOne" name="ONE on ONE"/>
    <bpmn:task id="A_Bancas" name="Apresentar bancas"/>
    <bpmn:task id="A_RetroGeral" name="Retrospectiva geral e confraternização"/>
    <bpmn:task id="A_RelatorioFinal" name="Entregar relatório final"/>
    <bpmn:task id="A_ApresentacaoFinal" name="Apresentar projetos AGES"/>
    <bpmn:endEvent id="End" name="Fim"/>
    <bpmn:task id="A_ValidarIdeia" name="Validar ideia"/>
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="A_Ideia"/>
    <bpmn:sequenceFlow id="F02" sourceRef="A_Ideia" targetRef="A_ValidarIdeia"/>
    <bpmn:sequenceFlow id="F03" sourceRef="A_ValidarIdeia" targetRef="A_Semestre"/>
    <bpmn:sequenceFlow id="F04" sourceRef="A_Semestre" targetRef="A_ReqStakeholders"/>
    <bpmn:sequenceFlow id="F09" name="Revisar requisitos" sourceRef="G_Aprovado" targetRef="A_ReqStakeholders"/>
    <bpmn:sequenceFlow id="F05" sourceRef="A_ReqStakeholders" targetRef="A_ValidarReq"/>
    <bpmn:sequenceFlow id="F06" sourceRef="A_ValidarReq" targetRef="A_Termo"/>
    <bpmn:sequenceFlow id="F07" sourceRef="A_Termo" targetRef="G_Aprovado"/>
    <bpmn:sequenceFlow id="F08" name="Sim" sourceRef="G_Aprovado" targetRef="A_Intro"/>
    <bpmn:sequenceFlow id="F25" sourceRef="A_Sprints" targetRef="A_EntregaSprint"/>
    <bpmn:sequenceFlow id="F30" sourceRef="A_Bancas" targetRef="A_RetroGeral"/>
    <bpmn:sequenceFlow id="F31" sourceRef="A_RetroGeral" targetRef="A_RelatorioFinal"/>
    <bpmn:sequenceFlow id="F32" sourceRef="A_RelatorioFinal" targetRef="A_ApresentacaoFinal"/>
    <bpmn:sequenceFlow id="F33" sourceRef="A_ApresentacaoFinal" targetRef="End"/>
    <bpmn:task id="A_MapearJornada" name="Mapear jornada com Stakeholders"/>
    <bpmn:task id="A_DefinirMVP" name="Priorizar histórias e definir MVP"/>
    <bpmn:task id="A_DefinirEpicos" name="Especificar épicos"/>
    <bpmn:task id="A_DefinirHistorias" name="Especificar histórias"/>
    <bpmn:task id="A_FormarSquads" name="Formar squads"/>
    <bpmn:task id="A_DecomporTasks" name="Decompor histórias em tasks"/>
    <bpmn:task id="A_DefinirGuardrails" name="Definir guardrails de IA"/>
    <bpmn:task id="A_CoordPoC" name="Coordenar PoC transversalmente"/>
    <bpmn:task id="A_DesignSystem" name="Preparar design system"/>
    <bpmn:task id="A_ConfigIA" name="Configurar agente de IA"/>
    <bpmn:task id="A_Wireframes" name="Criar wireframes"/>
    <bpmn:task id="A_Wireflows" name="Desenhar wireflows"/>
    <bpmn:task id="A_ConstruirPoC" name="Construir PoC em pares"/>
    <bpmn:task id="A_DemoPoC" name="Demonstrar PoCs"/>
    <bpmn:task id="A_ValidarUsuarios" name="Validar PoC com usuários"/>
    <bpmn:exclusiveGateway id="G_PoCValidada" name="PoC atende aos critérios?"/>
    <bpmn:task id="A_AjustarPoC" name="Ajustar PoC e backlog"/>
    <bpmn:task id="A_Planning" name="Definir Sprint Goal e backlog"/>
    <bpmn:sequenceFlow id="F10" sourceRef="A_Intro" targetRef="A_MapearJornada"/>
    <bpmn:sequenceFlow id="F11" sourceRef="A_MapearJornada" targetRef="A_DefinirMVP"/>
    <bpmn:sequenceFlow id="F12" sourceRef="A_DefinirMVP" targetRef="A_DefinirEpicos"/>
    <bpmn:sequenceFlow id="F13" sourceRef="A_DefinirEpicos" targetRef="A_DefinirHistorias"/>
    <bpmn:sequenceFlow id="F14" sourceRef="A_DefinirHistorias" targetRef="A_FormarSquads"/>
    <bpmn:sequenceFlow id="F15" sourceRef="A_FormarSquads" targetRef="A_GerirSquads"/>
    <bpmn:sequenceFlow id="F16" sourceRef="A_DecomporTasks" targetRef="A_DefinirGuardrails"/>
    <bpmn:sequenceFlow id="F17" sourceRef="A_DefinirGuardrails" targetRef="A_CoordPoC"/>
    <bpmn:sequenceFlow id="F18" sourceRef="A_CoordPoC" targetRef="A_DesignSystem"/>
    <bpmn:sequenceFlow id="F19" sourceRef="A_DesignSystem" targetRef="A_ConfigIA"/>
    <bpmn:sequenceFlow id="F20" sourceRef="A_ConfigIA" targetRef="A_Wireframes"/>
    <bpmn:sequenceFlow id="F21" sourceRef="A_Wireframes" targetRef="A_Wireflows"/>
    <bpmn:sequenceFlow id="F22" sourceRef="A_Wireflows" targetRef="A_ConstruirPoC"/>
    <bpmn:sequenceFlow id="F34" sourceRef="A_DemoPoC" targetRef="A_ValidarUsuarios"/>
    <bpmn:sequenceFlow id="F35" sourceRef="A_ValidarUsuarios" targetRef="G_PoCValidada"/>
    <bpmn:sequenceFlow id="F36" sourceRef="G_PoCValidada" targetRef="A_AjustarPoC" name="Não"/>
    <bpmn:sequenceFlow id="F37" sourceRef="A_AjustarPoC" targetRef="A_ConstruirPoC"/>
    <bpmn:sequenceFlow id="F38" sourceRef="G_PoCValidada" targetRef="A_Planning" name="Sim"/>
    <bpmn:sequenceFlow id="F39" sourceRef="A_Planning" targetRef="A_Sprints"/>
    <bpmn:dataObject id="DO_StoryMap" name="User Story Map"/>
    <bpmn:dataObjectReference id="DOR_StoryMap" name="User Story Map" dataObjectRef="DO_StoryMap"/>
    <bpmn:association id="Assoc_StoryMap" sourceRef="A_MapearJornada" targetRef="DOR_StoryMap" associationDirection="One"/>
    <bpmn:dataObject id="DO_MVP" name="MVP"/>
    <bpmn:dataObjectReference id="DOR_MVP" name="MVP" dataObjectRef="DO_MVP"/>
    <bpmn:association id="Assoc_MVP" sourceRef="A_DefinirMVP" targetRef="DOR_MVP" associationDirection="One"/>
    <bpmn:dataObject id="DO_Epicos" name="Épicos"/>
    <bpmn:dataObjectReference id="DOR_Epicos" name="Épicos" dataObjectRef="DO_Epicos"/>
    <bpmn:association id="Assoc_Epicos" sourceRef="A_DefinirEpicos" targetRef="DOR_Epicos" associationDirection="One"/>
    <bpmn:dataObject id="DO_Historias" name="Histórias"/>
    <bpmn:dataObjectReference id="DOR_Historias" name="Histórias" dataObjectRef="DO_Historias"/>
    <bpmn:association id="Assoc_Historias" sourceRef="A_DefinirHistorias" targetRef="DOR_Historias" associationDirection="One"/>
    <bpmn:dataObject id="DO_Squads" name="Squads"/>
    <bpmn:dataObjectReference id="DOR_Squads" name="Squads" dataObjectRef="DO_Squads"/>
    <bpmn:association id="Assoc_Squads" sourceRef="A_FormarSquads" targetRef="DOR_Squads" associationDirection="One"/>
    <bpmn:dataObject id="DO_TaskBacklog" name="Backlog de tasks"/>
    <bpmn:dataObjectReference id="DOR_TaskBacklog" name="Backlog de tasks" dataObjectRef="DO_TaskBacklog"/>
    <bpmn:association id="Assoc_TaskBacklog" sourceRef="A_DecomporTasks" targetRef="DOR_TaskBacklog" associationDirection="One"/>
    <bpmn:dataObject id="DO_Guardrails" name="Guardrails IA"/>
    <bpmn:dataObjectReference id="DOR_Guardrails" name="Guardrails IA" dataObjectRef="DO_Guardrails"/>
    <bpmn:association id="Assoc_Guardrails" sourceRef="A_DefinirGuardrails" targetRef="DOR_Guardrails" associationDirection="One"/>
    <bpmn:dataObject id="DO_AgendaPoC" name="Plano da PoC"/>
    <bpmn:dataObjectReference id="DOR_AgendaPoC" name="Plano da PoC" dataObjectRef="DO_AgendaPoC"/>
    <bpmn:association id="Assoc_AgendaPoC" sourceRef="A_CoordPoC" targetRef="DOR_AgendaPoC" associationDirection="One"/>
    <bpmn:dataObject id="DO_DesignSystem" name="Design system"/>
    <bpmn:dataObjectReference id="DOR_DesignSystem" name="Design system" dataObjectRef="DO_DesignSystem"/>
    <bpmn:association id="Assoc_DesignSystem" sourceRef="A_DesignSystem" targetRef="DOR_DesignSystem" associationDirection="One"/>
    <bpmn:dataObject id="DO_AgenteIA" name="Agente configurado"/>
    <bpmn:dataObjectReference id="DOR_AgenteIA" name="Agente configurado" dataObjectRef="DO_AgenteIA"/>
    <bpmn:association id="Assoc_AgenteIA" sourceRef="A_ConfigIA" targetRef="DOR_AgenteIA" associationDirection="One"/>
    <bpmn:dataObject id="DO_Wireframes" name="Wireframes"/>
    <bpmn:dataObjectReference id="DOR_Wireframes" name="Wireframes" dataObjectRef="DO_Wireframes"/>
    <bpmn:association id="Assoc_Wireframes" sourceRef="A_Wireframes" targetRef="DOR_Wireframes" associationDirection="One"/>
    <bpmn:dataObject id="DO_Wireflows" name="Wireflows"/>
    <bpmn:dataObjectReference id="DOR_Wireflows" name="Wireflows" dataObjectRef="DO_Wireflows"/>
    <bpmn:association id="Assoc_Wireflows" sourceRef="A_Wireflows" targetRef="DOR_Wireflows" associationDirection="One"/>
    <bpmn:dataObject id="DO_PoC" name="PoC"/>
    <bpmn:dataObjectReference id="DOR_PoC" name="PoC" dataObjectRef="DO_PoC"/>
    <bpmn:association id="Assoc_PoC" sourceRef="A_ConstruirPoC" targetRef="DOR_PoC" associationDirection="One"/>
    <bpmn:dataObject id="DO_ReviewTasks" name="Tasks aprovadas"/>
    <bpmn:dataObjectReference id="DOR_ReviewTasks" name="Tasks aprovadas" dataObjectRef="DO_ReviewTasks"/>
    <bpmn:association id="Assoc_ReviewTasks" sourceRef="A_AprovarTaskIV" targetRef="DOR_ReviewTasks" associationDirection="One"/>
    <bpmn:dataObject id="DO_Critique" name="Registro da critique"/>
    <bpmn:dataObjectReference id="DOR_Critique" name="Registro da critique" dataObjectRef="DO_Critique"/>
    <bpmn:association id="Assoc_Critique" sourceRef="A_DemoPoC" targetRef="DOR_Critique" associationDirection="One"/>
    <bpmn:dataObject id="DO_Validacao" name="Achados de usuários"/>
    <bpmn:dataObjectReference id="DOR_Validacao" name="Achados de usuários" dataObjectRef="DO_Validacao"/>
    <bpmn:association id="Assoc_Validacao" sourceRef="A_ValidarUsuarios" targetRef="DOR_Validacao" associationDirection="One"/>
    <bpmn:dataObject id="DO_SprintBacklog" name="Sprint Goal e backlog"/>
    <bpmn:dataObjectReference id="DOR_SprintBacklog" name="Sprint Goal e backlog" dataObjectRef="DO_SprintBacklog"/>
    <bpmn:association id="Assoc_SprintBacklog" sourceRef="A_Planning" targetRef="DOR_SprintBacklog" associationDirection="One"/>
    <bpmn:task id="A_CodeReview" name="Revisar código"/>
    <bpmn:task id="A_AprovarTaskIII" name="Aprovar task tecnicamente"/>
    <bpmn:task id="A_AprovarTaskIV" name="Aprovar task"/>
    <bpmn:sequenceFlow id="F23" sourceRef="A_ConstruirPoC" targetRef="A_CodeReview"/>
    <bpmn:sequenceFlow id="F24" sourceRef="A_CodeReview" targetRef="A_AprovarTaskIII"/>
    <bpmn:sequenceFlow id="F40" sourceRef="A_AprovarTaskIII" targetRef="A_AprovarTaskIV"/>
    <bpmn:sequenceFlow id="F41" sourceRef="A_AprovarTaskIV" targetRef="A_DemoPoC"/>
    <bpmn:task id="A_EnviarNPS" name="Enviar formulário NPS"/>
    <bpmn:sequenceFlow id="F26" sourceRef="A_EntregaSprint" targetRef="A_EnviarNPS"/>
    <bpmn:sequenceFlow id="F27" sourceRef="A_EnviarNPS" targetRef="A_RetroSprint"/>
    <bpmn:dataObject id="DO_NPS" name="Respostas NPS"/>
    <bpmn:dataObjectReference id="DOR_NPS" name="Respostas NPS" dataObjectRef="DO_NPS"/>
    <bpmn:association id="Assoc_NPS" sourceRef="A_EnviarNPS" targetRef="DOR_NPS" associationDirection="One"/>
    <bpmn:dataObject id="DO_Req" name="Requisitos"/>
    <bpmn:dataObjectReference id="DOR_Req" name="Requisitos" dataObjectRef="DO_Req"/>
    <bpmn:association id="Assoc_Req" sourceRef="A_ReqStakeholders" targetRef="DOR_Req" associationDirection="One"/>
    <bpmn:dataObject id="DO_Charter" name="Termo de abertura"/>
    <bpmn:dataObjectReference id="DOR_Charter" name="Termo de abertura" dataObjectRef="DO_Charter"/>
    <bpmn:association id="Assoc_Charter" sourceRef="A_Termo" targetRef="DOR_Charter" associationDirection="One"/>
    <bpmn:textAnnotation id="Note_Pairing">
      <bpmn:text>AGES I e II desenvolvem em pares inter-níveis, com apoio técnico de AGES III e IA conforme guardrails de AGES IV. WIP 0,5 por integrante.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Pairing" sourceRef="A_ConstruirPoC" targetRef="Note_Pairing" associationDirection="None"/>
    <bpmn:exclusiveGateway id="G_SprintsConcluidas" name="Sprints concluídas?"/>
    <bpmn:sequenceFlow id="F28" sourceRef="A_RetroSprint" targetRef="G_SprintsConcluidas"/>
    <bpmn:sequenceFlow id="F42" name="Sim" sourceRef="G_SprintsConcluidas" targetRef="A_Andamento"/>
    <bpmn:sequenceFlow id="F43" name="Não" sourceRef="G_SprintsConcluidas" targetRef="A_Planning"/>
    <bpmn:sequenceFlow id="F29" sourceRef="A_Andamento" targetRef="A_OneOnOne"/>
    <bpmn:dataObject id="DO_Incremento" name="Incremento da sprint"/>
    <bpmn:dataObjectReference id="DOR_Incremento" name="Incremento da sprint" dataObjectRef="DO_Incremento"/>
    <bpmn:association id="Assoc_Incremento" sourceRef="A_EntregaSprint" targetRef="DOR_Incremento" associationDirection="One"/>
    <bpmn:dataObject id="DO_RetroActions" name="Ações da retrospectiva"/>
    <bpmn:dataObjectReference id="DOR_RetroActions" name="Ações da retrospectiva" dataObjectRef="DO_RetroActions"/>
    <bpmn:association id="Assoc_RetroActions" sourceRef="A_RetroSprint" targetRef="DOR_RetroActions" associationDirection="One"/>
    <bpmn:task id="A_GerirSquads" name="Gerenciar squads"/>
    <bpmn:dataObject id="DO_AcordosSquad" name="Acordos das squads"/>
    <bpmn:dataObjectReference id="DOR_AcordosSquad" name="Acordos das squads" dataObjectRef="DO_AcordosSquad"/>
    <bpmn:association id="Assoc_AcordosSquad" sourceRef="A_GerirSquads" targetRef="DOR_AcordosSquad" associationDirection="One"/>
    <bpmn:dataObject id="DO_BacklogAtualizado" name="Backlog atualizado"/>
    <bpmn:dataObjectReference id="DOR_BacklogAtualizado" name="Backlog atualizado" dataObjectRef="DO_BacklogAtualizado"/>
    <bpmn:association id="Assoc_BacklogAtualizado" sourceRef="A_AjustarPoC" targetRef="DOR_BacklogAtualizado" associationDirection="One"/>
    <bpmn:sequenceFlow id="F44" sourceRef="A_GerirSquads" targetRef="A_DecomporTasks"/>
    <bpmn:sequenceFlow id="F45" sourceRef="A_OneOnOne" targetRef="A_Bancas"/>
  </bpmn:process>
  <bpmn:process id="Process_Sprint_Proposto" name="Sprint regular de duas semanas" isExecutable="false">
    <bpmn:startEvent id="Sprint_Start" name="Início"/>
    <bpmn:task id="Sprint_Planning" name="Planejar blocos curtos"/>
    <bpmn:task id="Sprint_Work" name="Executar tasks em pares"/>
    <bpmn:task id="Sprint_BlockFeedback" name="Revisar bloco e obter feedback"/>
    <bpmn:exclusiveGateway id="Sprint_Continue" name="Continuar ou ajustar no tempo restante?"/>
    <bpmn:task id="Sprint_Meeting" name="Aula Meeting"/>
    <bpmn:parallelGateway id="Sprint_Split"/>
    <bpmn:parallelGateway id="Sprint_Join"/>
    <bpmn:endEvent id="Sprint_End" name="Fim"/>
    <bpmn:sequenceFlow id="SF1" sourceRef="Sprint_Start" targetRef="Sprint_Planning"/>
    <bpmn:sequenceFlow id="SF2" sourceRef="Sprint_Planning" targetRef="Sprint_Split"/>
    <bpmn:sequenceFlow id="SF3" sourceRef="Sprint_Split" targetRef="Sprint_Work"/>
    <bpmn:sequenceFlow id="SF4" sourceRef="Sprint_Split" targetRef="Sprint_Meeting"/>
    <bpmn:sequenceFlow id="SF5" sourceRef="Sprint_Work" targetRef="Sprint_BlockFeedback"/>
    <bpmn:sequenceFlow id="SF6" sourceRef="Sprint_Meeting" targetRef="Sprint_Join"/>
    <bpmn:sequenceFlow id="SF7" sourceRef="Sprint_BlockFeedback" targetRef="Sprint_Continue"/>
    <bpmn:sequenceFlow id="SF8" name="Sim: próximo bloco/ajuste" sourceRef="Sprint_Continue" targetRef="Sprint_Work"/>
    <bpmn:sequenceFlow id="SF9" name="Não: blocos concluídos" sourceRef="Sprint_Continue" targetRef="Sprint_Join"/>
    <bpmn:sequenceFlow id="SF10" sourceRef="Sprint_Join" targetRef="Sprint_End"/>
  </bpmn:process>
