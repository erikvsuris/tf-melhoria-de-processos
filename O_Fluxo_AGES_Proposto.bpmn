<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AGES_Proposto" name="O Fluxo AGES Proposto" targetNamespace="https://ages.pucrs.br/bpmn/o-fluxo-ages-proposto">
  <bpmn:documentation>Rascunho de alto nível para o Resultado 1 do TF de Melhoria de Processos. Baseado no processo atual anexado e nas propostas registradas no README. O modelo de trabalho com Double Diamond é uma adaptação proposta pelo grupo: Coordenação e Stakeholders conduzem descoberta/definição; a equipe AGES I–IV atua no desenvolvimento/entrega. Sprint 0 é representada como Spike/PoC iterativa, com apoio de IA, revisão humana e validação com usuários. Detalhes ainda sujeitos a revisão.</bpmn:documentation>
  <bpmn:collaboration id="Collaboration_Proposto">
    <bpmn:participant id="Participant_Proposto" name="O FLUXO AGES PROPOSTO" processRef="Process_Proposto" />
    <bpmn:participant id="Participant_Stakeholders" name="Stakeholders" />
    <bpmn:participant id="Participant_Usuarios" name="Usuários" />
    <bpmn:messageFlow id="MF_Ideia" name="Ideia" sourceRef="Participant_Stakeholders" targetRef="A_Ideia" />
    <bpmn:messageFlow id="MF_Requisitos" name="Esclarecimentos e validação" sourceRef="A_ReqStakeholders" targetRef="Participant_Stakeholders" />
    <bpmn:messageFlow id="MF_PoC" name="Demonstração da PoC" sourceRef="A_DemoPoC" targetRef="Participant_Stakeholders" />
    <bpmn:messageFlow id="MF_Usuario" name="Uso observado e feedback" sourceRef="A_ValidarUsuarios" targetRef="Participant_Usuarios" />
    <bpmn:messageFlow id="MF_Entrega" name="Demonstrações e entregas" sourceRef="A_EntregaSprint" targetRef="Participant_Stakeholders" />
    <bpmn:textAnnotation id="Note_Etapa1"><bpmn:text>Etapa 1: Semestre que antecede a execução do projeto na AGES</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Etapa2"><bpmn:text>Etapa 2: Organização e kick-off do projeto</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Sprint0"><bpmn:text>Sprint 0 — Spike/PoC (proposta)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Diamond1"><bpmn:text>Double Diamond — Descobrir/Definir: Coordenação e Stakeholders</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Diamond2"><bpmn:text>Double Diamond — Desenvolver/Entregar: equipe AGES I–IV</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Etapa3"><bpmn:text>Etapa 3: Sprints iniciais e Revisão intermediária</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Etapa4"><bpmn:text>Etapa 4: Encerramento</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:message id="Message_Ideia" name="Apresentação da Ideia pelos stakeholder" />
  <bpmn:process id="Process_Proposto" name="O Fluxo AGES Proposto" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proposto">
      <bpmn:lane id="Lane_Coordenacao" name="Coordenação"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Ideia</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ValidarIdeia</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Semestre</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ReqStakeholders</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ValidarReq</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Termo</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Aprovado</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Intro</bpmn:flowNodeRef><bpmn:flowNodeRef>A_EntregaSprint</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Andamento</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Bancas</bpmn:flowNodeRef><bpmn:flowNodeRef>A_RetroGeral</bpmn:flowNodeRef><bpmn:flowNodeRef>A_RelatorioFinal</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ApresentacaoFinal</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Professor" name="Professor Orientador"><bpmn:flowNodeRef>A_OneOnOne</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_AGESIV" name="AGES IV"><bpmn:flowNodeRef>A_MapearCore</bpmn:flowNodeRef><bpmn:flowNodeRef>A_EpicosUS</bpmn:flowNodeRef><bpmn:flowNodeRef>A_CoordPoC</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Planning</bpmn:flowNodeRef><bpmn:flowNodeRef>A_RetroSprint</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_AGESIII" name="AGES III"><bpmn:flowNodeRef>A_DecomporTasks</bpmn:flowNodeRef><bpmn:flowNodeRef>A_DesignSystem</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ConfigIA</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ReviewAprovar</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_AGESI_II" name="AGES I e II"><bpmn:flowNodeRef>A_PrototipoIA</bpmn:flowNodeRef><bpmn:flowNodeRef>A_DemoPoC</bpmn:flowNodeRef><bpmn:flowNodeRef>A_ValidarUsuarios</bpmn:flowNodeRef><bpmn:flowNodeRef>G_PoCValidada</bpmn:flowNodeRef><bpmn:flowNodeRef>A_AjustarPoC</bpmn:flowNodeRef><bpmn:flowNodeRef>A_Sprints</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Início" />
    <bpmn:receiveTask id="A_Ideia" name="Apresentação da Ideia pelos stakeholder" messageRef="Message_Ideia" />
    <bpmn:task id="A_ValidarIdeia" name="Validação da Ideia" />
    <bpmn:task id="A_Semestre" name="Definição do semestre que o projeto irá ser executado" />
    <bpmn:task id="A_ReqStakeholders" name="Reuniões com os Stakeholders: elicitar requisitos funcionais e não funcionais (qualidade, segurança, desempenho e restrições)" />
    <bpmn:task id="A_ValidarReq" name="Validação dos Requisitos" />
    <bpmn:task id="A_Termo" name="Elaboração do Termo de Abertura de Projetos" />
    <bpmn:exclusiveGateway id="G_Aprovado" name="Projeto aprovado e pronto para execução?" />
    <bpmn:task id="A_Intro" name="Apresentação Inicial AGES e do Fluxo AGES." />
    <bpmn:task id="A_MapearCore" name="Mapear o core do produto e definir o MVP com participação da equipe AGES I–IV" />
    <bpmn:task id="A_EpicosUS" name="AGES IV especificam épicos e User Stories" />
    <bpmn:task id="A_DecomporTasks" name="AGES III, I e II decompõem User Stories em tasks e verificam arquitetura/dependências" />
    <bpmn:task id="A_CoordPoC" name="AGES IV coordenam a Spike/PoC e o trabalho das squads" />
    <bpmn:task id="A_DesignSystem" name="Preparar design system: variables, styles e componentes com base na identidade visual" />
    <bpmn:task id="A_ConfigIA" name="Configurar ambiente e agente de IA para apoiar a construção do protótipo" />
    <bpmn:task id="A_PrototipoIA" name="Construir protótipo funcional de alta fidelidade com apoio de IA (fluxos core; backend ausente ou dados mockados)" />
    <bpmn:task id="A_ReviewAprovar" name="Code review AGES III e aprovação de AGES III e AGES IV para cada task; reprovação retorna para correção" />
    <bpmn:task id="A_DemoPoC" name="Demonstração da PoC aos Stakeholders e coleta de feedback" />
    <bpmn:task id="A_ValidarUsuarios" name="Validar com usuários: observar o uso do protótipo e registrar feedback (técnica a definir)" />
    <bpmn:exclusiveGateway id="G_PoCValidada" name="Core/PoC atende aos critérios acordados?" />
    <bpmn:task id="A_AjustarPoC" name="Ajustar protótipo, tasks e histórias com base nos achados" />
    <bpmn:task id="A_Planning" name="Planning colaborativa: priorizar histórias e selecionar tasks" />
    <bpmn:callActivity id="A_Sprints" name="Sprints regulares (ciclo de duas semanas)" calledElement="Process_Sprint_Proposto" />
    <bpmn:task id="A_EntregaSprint" name="Entrega para os Stakeholders" />
    <bpmn:task id="A_RetroSprint" name="Retrospectiva" />
    <bpmn:task id="A_Andamento" name="Entrega Relatório de Andamento" />
    <bpmn:task id="A_OneOnOne" name="ONE on ONE (com os alunos)" />
    <bpmn:task id="A_Bancas" name="Apresentação das BANCAS" />
    <bpmn:task id="A_RetroGeral" name="Retrospectiva geral da AGES + Confraternização" />
    <bpmn:task id="A_RelatorioFinal" name="Entrega Relatório Final" />
    <bpmn:task id="A_ApresentacaoFinal" name="Apresentação dos projetos da AGES (estudantes + stakeholders + professores)" />
    <bpmn:endEvent id="End" name="Fim" />
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="A_Ideia" />
    <bpmn:sequenceFlow id="F02" sourceRef="A_Ideia" targetRef="A_ValidarIdeia" />
    <bpmn:sequenceFlow id="F03" sourceRef="A_ValidarIdeia" targetRef="A_Semestre" />
    <bpmn:sequenceFlow id="F04" sourceRef="A_Semestre" targetRef="A_ReqStakeholders" />
    <bpmn:sequenceFlow id="F05" sourceRef="A_ReqStakeholders" targetRef="A_ValidarReq" />
    <bpmn:sequenceFlow id="F06" sourceRef="A_ValidarReq" targetRef="A_Termo" />
    <bpmn:sequenceFlow id="F07" sourceRef="A_Termo" targetRef="G_Aprovado" />
    <bpmn:sequenceFlow id="F08" name="Sim" sourceRef="G_Aprovado" targetRef="A_Intro" />
    <bpmn:sequenceFlow id="F09" name="Revisar requisitos" sourceRef="G_Aprovado" targetRef="A_ReqStakeholders" />
    <bpmn:sequenceFlow id="F10" sourceRef="A_Intro" targetRef="A_MapearCore" />
    <bpmn:sequenceFlow id="F11" sourceRef="A_MapearCore" targetRef="A_EpicosUS" />
    <bpmn:sequenceFlow id="F12" sourceRef="A_EpicosUS" targetRef="A_DecomporTasks" />
    <bpmn:sequenceFlow id="F13" sourceRef="A_DecomporTasks" targetRef="A_CoordPoC" />
    <bpmn:sequenceFlow id="F14" sourceRef="A_CoordPoC" targetRef="A_DesignSystem" />
    <bpmn:sequenceFlow id="F15" sourceRef="A_DesignSystem" targetRef="A_ConfigIA" />
    <bpmn:sequenceFlow id="F16" sourceRef="A_ConfigIA" targetRef="A_PrototipoIA" />
    <bpmn:sequenceFlow id="F17" sourceRef="A_PrototipoIA" targetRef="A_ReviewAprovar" />
    <bpmn:sequenceFlow id="F18" sourceRef="A_ReviewAprovar" targetRef="A_DemoPoC" />
    <bpmn:sequenceFlow id="F19" sourceRef="A_DemoPoC" targetRef="A_ValidarUsuarios" />
    <bpmn:sequenceFlow id="F20" sourceRef="A_ValidarUsuarios" targetRef="G_PoCValidada" />
    <bpmn:sequenceFlow id="F21" name="Não: iterar" sourceRef="G_PoCValidada" targetRef="A_AjustarPoC" />
    <bpmn:sequenceFlow id="F22" sourceRef="A_AjustarPoC" targetRef="A_PrototipoIA" />
    <bpmn:sequenceFlow id="F23" name="Sim" sourceRef="G_PoCValidada" targetRef="A_Planning" />
    <bpmn:sequenceFlow id="F24" sourceRef="A_Planning" targetRef="A_Sprints" />
    <bpmn:sequenceFlow id="F25" sourceRef="A_Sprints" targetRef="A_EntregaSprint" />
    <bpmn:sequenceFlow id="F26" sourceRef="A_EntregaSprint" targetRef="A_RetroSprint" />
    <bpmn:sequenceFlow id="F27" sourceRef="A_RetroSprint" targetRef="A_Andamento" />
    <bpmn:sequenceFlow id="F28" sourceRef="A_Andamento" targetRef="A_OneOnOne" />
    <bpmn:sequenceFlow id="F29" sourceRef="A_OneOnOne" targetRef="A_Bancas" />
    <bpmn:sequenceFlow id="F30" sourceRef="A_Bancas" targetRef="A_RetroGeral" />
    <bpmn:sequenceFlow id="F31" sourceRef="A_RetroGeral" targetRef="A_RelatorioFinal" />
    <bpmn:sequenceFlow id="F32" sourceRef="A_RelatorioFinal" targetRef="A_ApresentacaoFinal" />
    <bpmn:sequenceFlow id="F33" sourceRef="A_ApresentacaoFinal" targetRef="End" />
  </bpmn:process>
  <bpmn:process id="Process_Sprint_Proposto" name="Sprint regular de duas semanas" isExecutable="false">
    <bpmn:startEvent id="Sprint_Start" name="Início" />
    <bpmn:task id="Sprint_Planning" name="Planning colaborativa" />
    <bpmn:task id="Sprint_Work" name="Desenvolvimento e documentação (tasks com IA quando aplicável; code review e aprovação AGES III/IV)" />
    <bpmn:task id="Sprint_Meeting" name="Aula Meeting" />
    <bpmn:parallelGateway id="Sprint_Split" />
    <bpmn:parallelGateway id="Sprint_Join" />
    <bpmn:task id="Sprint_Delivery" name="Entrega para os Stakeholders" />
    <bpmn:task id="Sprint_Retro" name="Retrospectiva" />
    <bpmn:task id="Sprint_Report" name="Entrega do relatório da Sprint" />
    <bpmn:endEvent id="Sprint_End" name="Fim" />
    <bpmn:sequenceFlow id="SF1" sourceRef="Sprint_Start" targetRef="Sprint_Planning" />
    <bpmn:sequenceFlow id="SF2" sourceRef="Sprint_Planning" targetRef="Sprint_Split" />
    <bpmn:sequenceFlow id="SF3" sourceRef="Sprint_Split" targetRef="Sprint_Work" />
    <bpmn:sequenceFlow id="SF4" sourceRef="Sprint_Split" targetRef="Sprint_Meeting" />
    <bpmn:sequenceFlow id="SF5" sourceRef="Sprint_Work" targetRef="Sprint_Join" />
    <bpmn:sequenceFlow id="SF6" sourceRef="Sprint_Meeting" targetRef="Sprint_Join" />
    <bpmn:sequenceFlow id="SF7" sourceRef="Sprint_Join" targetRef="Sprint_Delivery" />
    <bpmn:sequenceFlow id="SF8" sourceRef="Sprint_Delivery" targetRef="Sprint_Retro" />
    <bpmn:sequenceFlow id="SF9" sourceRef="Sprint_Retro" targetRef="Sprint_Report" />
    <bpmn:sequenceFlow id="SF10" sourceRef="Sprint_Report" targetRef="Sprint_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Proposto" name="O Fluxo AGES Proposto">
    <bpmndi:BPMNPlane id="Plane_Proposto" bpmnElement="Collaboration_Proposto">
      <bpmndi:BPMNShape id="DI_Pool" bpmnElement="Participant_Proposto" isHorizontal="true" isExpanded="true"><dc:Bounds x="100" y="100" width="6100" height="960" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_LaneCoord" bpmnElement="Lane_Coordenacao" isHorizontal="true"><dc:Bounds x="130" y="100" width="6070" height="230" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_LaneProf" bpmnElement="Lane_Professor" isHorizontal="true"><dc:Bounds x="130" y="330" width="6070" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_LaneIV" bpmnElement="Lane_AGESIV" isHorizontal="true"><dc:Bounds x="130" y="460" width="6070" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_LaneIII" bpmnElement="Lane_AGESIII" isHorizontal="true"><dc:Bounds x="130" y="610" width="6070" height="160" /></bpmndi:BPMNShape>
