<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AGES_Proposto" name="O Fluxo AGES Proposto Sugerido" targetNamespace="https://ages.pucrs.br/bpmn/o-fluxo-ages-proposto-sugerido" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.1">
  <bpmn:documentation>Visão de alto nível para o Resultado 1 do TF de Melhoria de Processos. O Double Diamond é uma adaptação proposta pelo grupo: Coordenação e Stakeholders conduzem descoberta e definição, enquanto a equipe AGES atua no desenvolvimento e na entrega. Tanto na Sprint 0 quanto nas Sprints regulares (1 a 4), o desenvolvimento ocorre em pares com apoio de IA, seguido de demonstração síncrona para code review com AGES III e validação de Definition of Done com AGES IV em ciclos condicionais de feedback e ajuste.</bpmn:documentation>
  <bpmn:category id="Cat_Etapas" name="Etapas do Fluxo AGES">
    <bpmn:categoryValue id="CatVal_Etapa1" value="Etapa 1: Semestre que antecede a execução do projeto na AGES"/>
    <bpmn:categoryValue id="CatVal_Etapa2" value="Etapa 2: Organização e kick-off do projeto"/>
    <bpmn:categoryValue id="CatVal_Sprint0" value="Sprint 0 — PoC"/>
    <bpmn:categoryValue id="CatVal_Etapa3" value="Etapa 3: Sprints regulares e Revisão intermediária"/>
    <bpmn:categoryValue id="CatVal_Etapa4" value="Etapa 4: Encerramento"/>
  </bpmn:category>
  <bpmn:message id="Message_Ideia" name="Apresentação da Ideia pelos stakeholder"/>
  <bpmn:collaboration id="Collaboration_Proposto">
    <bpmn:participant id="Participant_Proposto" name="O FLUXO AGES PROPOSTO SUGERIDO" processRef="Process_Proposto"/>
    <bpmn:participant id="Participant_Stakeholders" name="Stakeholders"/>
    <bpmn:participant id="Participant_Usuarios" name="Usuários"/>
    <bpmn:messageFlow id="MF_Ideia" name="Ideia" sourceRef="Participant_Stakeholders" targetRef="A_Ideia" messageRef="Message_Ideia"/>
    <bpmn:messageFlow id="MF_Requisitos" name="Requisitos para validação" sourceRef="A_ReqStakeholders" targetRef="Participant_Stakeholders"/>
    <bpmn:messageFlow id="MF_PoC" name="Demonstração da PoC" sourceRef="A_DemoPoC" targetRef="Participant_Stakeholders"/>
    <bpmn:messageFlow id="MF_Usuario" name="Feedback dos usuários" sourceRef="Participant_Usuarios" targetRef="A_ValidarUsuarios"/>
    <bpmn:messageFlow id="MF_Entrega" name="Incremento para Stakeholders" sourceRef="A_EntregaSprint" targetRef="Participant_Stakeholders"/>
    <bpmn:messageFlow id="MF_NPS" name="Formulário NPS" sourceRef="A_EnviarNPS" targetRef="Participant_Stakeholders"/>
    <bpmn:messageFlow id="MF_ApresentacaoFinal" name="Apresentação final dos projetos" sourceRef="A_ApresentacaoFinal" targetRef="Participant_Stakeholders"/>
    <bpmn:group id="Group_Etapa1" categoryValueRef="CatVal_Etapa1"/>
    <bpmn:group id="Group_Etapa2" categoryValueRef="CatVal_Etapa2"/>
    <bpmn:group id="Group_Sprint0" categoryValueRef="CatVal_Sprint0"/>
    <bpmn:group id="Group_Etapa3" categoryValueRef="CatVal_Etapa3"/>
    <bpmn:group id="Group_Etapa4" categoryValueRef="CatVal_Etapa4"/>
    <bpmn:textAnnotation id="Note_Diamond1">
      <bpmn:text>Double Diamond — Descobrir/Definir: Coordenação e Stakeholders</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Diamond2">
      <bpmn:text>Double Diamond — Desenvolver/Entregar: equipe AGES I–IV</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_Proposto" name="O Fluxo AGES Proposto Sugerido" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proposto">
      <bpmn:lane id="Lane_Coordenacao" name="Coordenação">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Ideia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ValidarIdeia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Semestre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_MergeReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ReqStakeholders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ValidarReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Termo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Aprovado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Intro</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Professor" name="Professor Orientador">
        <bpmn:flowNodeRef>A_AulaMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_OneOnOne</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AGESIV" name="AGES IV">
        <bpmn:flowNodeRef>A_DefinirEpicos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DefinirHistorias</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_FormarSquads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_GerirSquads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DefinirGuardrails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_CoordPoC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_AprovarTaskIV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PoCRevIV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_AprovarSprintIV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SprintRevIV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EnviarNPS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Bancas</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AGESIII" name="AGES III">
        <bpmn:flowNodeRef>A_DesignSystem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ConfigIA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_CodeReviewIII</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PoCRevIII</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PoCReprovado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_CodeReviewSprintIII</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SprintRevIII</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SprintReprovado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AGESI_II" name="Equipe AGES">
        <bpmn:flowNodeRef>A_MapearJornada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DefinirMVP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DecomporTasks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Wireframes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Wireflows</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_MergePoC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ConstruirPoC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DemoCodeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DemoPoC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ValidarUsuarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PoCValidada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_AjustarPoC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_MergePlanning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Planning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SprintSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_MergeBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DevSprint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DemoCodeReviewSprint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RevisarBloco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ProximoBloco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SprintJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_EntregaSprint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RetroSprint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Andamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SprintsConcluidas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RetroGeral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RelatorioFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ApresentacaoFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Início">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="A_Ideia" name="Apresentação da Ideia pelos stakeholder" messageRef="Message_Ideia">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="A_ValidarIdeia" name="Validar ideia">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_Semestre" name="Definir semestre de execução">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_MergeReq" gatewayDirection="Converging">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F04b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_ReqStakeholders" name="Elicitar requisitos com Stakeholders">
      <bpmn:incoming>F04b</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Req">
        <bpmn:targetRef>DOR_Req</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_ValidarReq" name="Validar requisitos">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_Termo" name="Elaborar termo de abertura">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Charter">
        <bpmn:targetRef>DOR_Charter</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Aprovado" name="Projeto aprovado e pronto para execução?" gatewayDirection="Diverging">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_Intro" name="Apresentar AGES e fluxo">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_MapearJornada" name="Mapear jornada com Stakeholders">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_StoryMap">
        <bpmn:targetRef>DOR_StoryMap</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_DefinirMVP" name="Priorizar histórias e definir MVP">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_MVP">
        <bpmn:targetRef>DOR_MVP</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="A_DefinirEpicos" name="Especificar épicos">
